[
  {
    "id": "wordcraft",
    "name": "WordCraft",
    "group": "Documents",
    "description": "Write and edit documents",
    "extensions": [
      "docx",
      "docm",
      "dotx",
      "dotm",
      "doc",
      "dot",
      "odt",
      "rtf",
      "txt",
      "md",
      "html",
      "htm",
      "tex"
    ],
    "notes": "Legacy DOC is import only. Macros are not Microsoft Office VBA execution.",
    "version": "0.8.0"
  },
  {
    "id": "gridcraft",
    "name": "GridCraft",
    "group": "Documents",
    "description": "Spreadsheets and calculations",
    "extensions": [
      "xlsx",
      "xlsm",
      "xls",
      "xlsb",
      "ods",
      "csv",
      "tsv"
    ],
    "notes": "XLS is import; XLSB and ODS are data import. Check formulas, formatting, macros and charts after importing.",
    "version": "0.8.0"
  },
  {
    "id": "deckcraft",
    "name": "DeckCraft",
    "group": "Documents",
    "description": "Presentations and slide shows",
    "extensions": [
      "deckcraft",
      "pptx",
      "potx",
      "ppsx"
    ],
    "notes": "Legacy PPT/PPS/POT and ODP use the AE companion conversion route; advanced PowerPoint fidelity is not guaranteed.",
    "version": "0.8.0"
  },
  {
    "id": "pdfcraft",
    "name": "PdfCraft",
    "group": "Documents",
    "description": "Read, edit and organize PDFs",
    "extensions": [
      "pdf"
    ],
    "notes": "Original native PdfCraft tools. This is not full Acrobat parity or a hosted e-signature service.",
    "version": "0.9.0"
  },
